<Window x:Class="GeneradorPDF.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagaré" Height="760" Width="900"
        MinHeight="600" MinWidth="760"
        Background="#E4E5E7"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#3D4656" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#3D4656" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CenteredSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="SignatureLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#676F7D" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#F0F1F3" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="#E8EAED" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style x:Key="TextInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#232B3B" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="#232B3B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="34" />
        </Style>

        <Style x:Key="TextArea" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#232B3B" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Height" Value="110" />
            <Setter Property="Padding" Value="2,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#08111D" Offset="0.0" />
                    <GradientStop Color="#211C1D" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="Pagaré" FontSize="28" FontWeight="SemiBold"
                       Foreground="#A48AFF" VerticalAlignment="Center" Margin="18,0" />
        </Border>

        <!-- Contenido con scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,20,22,28">
            <StackPanel>

                <TextBlock Text="PAGARÉ" FontSize="32" FontWeight="SemiBold"
                           Foreground="#232B3B" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,0,0,8" />

                <!-- Encabezado del pagaré: 6 campos -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="NÚMERO" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}" MaxLength="10" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="LUGAR" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox Text="{Binding Lugar, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="DÍA" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox Text="{Binding Dia, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}" MaxLength="2" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="MES" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox Text="{Binding Mes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Margin="0,0,10,0">
                            <TextBlock Text="AÑO" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox Text="{Binding Anio, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}" MaxLength="4" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="5">
                            <TextBlock Text="MONTO" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}" MaxLength="18"
                                         HorizontalContentAlignment="Right" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- A la orden de -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="A LA ORDEN DE" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource FieldBox}">
                            <TextBox Text="{Binding ALaOrdenDe, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInput}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- La cantidad de -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LA CANTIDAD DE" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource FieldBox}">
                            <TextBox Text="{Binding CantidadLetra, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInput}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Serie -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SERIE DEL PAGARÉ" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="SERIE DESDE" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <TextBox Text="{Binding SerieDesde, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextInput}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="SERIE HASTA" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <TextBox Text="{Binding SerieHasta, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextInput}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Interés moratorio -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="INTERÉS MORATORIO (%)" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource FieldBox}">
                            <TextBox Text="{Binding InteresMoratorioPorcentaje, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInput}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Deudor -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NOMBRE Y DATOS DEL DEUDOR" Style="{StaticResource CenteredSectionLabel}" />
                        <Border Style="{StaticResource FieldBox}" Padding="12,10">
                            <TextBox Text="{Binding NombreDeudor, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextArea}" />
                        </Border>
                        <TextBlock Text="FIRMA" Style="{StaticResource SignatureLabel}" />
                    </StackPanel>
                </Border>

                <!-- Avales: rejilla 2 columnas x 4 filas (7 avales) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,20">
                        <StackPanel>
                            <TextBlock Text="AVAL 1" Style="{StaticResource CenteredSectionLabel}" />
                            <Border Style="{StaticResource FieldBox}" Padding="12,10">
                                <TextBox Text="{Binding NombreAval1, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextArea}" />
                            </Border>
                            <TextBlock Text="FIRMA" Style="{StaticResource SignatureLabel}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,20">
                        <StackPanel>
                            <TextBlock Text="AVAL 2" Style="{StaticResource CenteredSectionLabel}" />
                            <Border Style="{StaticResource FieldBox}" Padding="12,10">
                                <TextBox Text="{Binding NombreAval2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextArea}" />
                            </Border>
                            <TextBlock Text="FIRMA" Style="{StaticResource SignatureLabel}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,20">
                        <StackPanel>
                            <TextBlock Text="AVAL 3" Style="{StaticResource CenteredSectionLabel}" />
                            <Border Style="{StaticResource FieldBox}" Padding="12,10">
                                <TextBox Text="{Binding NombreAval3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextArea}" />
                            </Border>
                            <TextBlock Text="FIRMA" Style="{StaticResource SignatureLabel}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,20">
                        <StackPanel>
                            <TextBlock Text="AVAL 4" Style="{StaticResource CenteredSectionLabel}" />
                            <Border Style="{StaticResource FieldBox}" Padding="12,10">
                                <TextBox Text="{Binding NombreAval4, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextArea}" />
                            </Border>
                            <TextBlock Text="FIRMA" Style="{StaticResource SignatureLabel}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,20">
                        <StackPanel>
                            <TextBlock Text="AVAL 5" Style="{StaticResource CenteredSectionLabel}" />
                            <Border Style="{StaticResource FieldBox}" Padding="12,10">
                                <TextBox Text="{Binding NombreAval5, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextArea}" />
                            </Border>
                            <TextBlock Text="FIRMA" Style="{StaticResource SignatureLabel}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,20">
                        <StackPanel>
                            <TextBlock Text="AVAL 6" Style="{StaticResource CenteredSectionLabel}" />
                            <Border Style="{StaticResource FieldBox}" Padding="12,10">
                                <TextBox Text="{Binding NombreAval6, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextArea}" />
                            </Border>
                            <TextBlock Text="FIRMA" Style="{StaticResource SignatureLabel}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="AVAL 7" Style="{StaticResource CenteredSectionLabel}" />
                            <Border Style="{StaticResource FieldBox}" Padding="12,10">
                                <TextBox Text="{Binding NombreAval7, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextArea}" />
                            </Border>
                            <TextBlock Text="FIRMA" Style="{StaticResource SignatureLabel}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Content="GENERAR PAGARÉ"
                        Command="{Binding GenerarPDFCommand}"
                        Height="56" FontSize="18" FontWeight="SemiBold"
                        Background="#2F66E7" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
